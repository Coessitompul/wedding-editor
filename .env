# Provider AI yang aktif: claude | openai | gemini | groq
VITE_AI_PROVIDER=claude

# Isi hanya yang kamu pakai (boleh dikosongkan dulu — AI diimplementasi di Tahap 2)
VITE_ANTHROPIC_API_KEY=
VITE_OPENAI_API_KEY=
VITE_GEMINI_API_KEY=
VITE_GROQ_API_KEY=

# Untuk production — ganti ke true dan isi URL backend kamu
VITE_USE_BACKEND_PROXY=false
VITE_BACKEND_URL=http://localhost:3001