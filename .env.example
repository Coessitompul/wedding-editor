# ─── AI Providers (Tahap 2) ────────────────────────────────────────────────────
# PERINGATAN: Jangan pernah taruh API key langsung di client-side production.
# Gunakan backend proxy untuk menyembunyikan key dari browser DevTools.

# Provider aktif: claude | openai | gemini | groq
VITE_AI_PROVIDER=claude

# API keys — isi hanya yang kamu pakai
VITE_ANTHROPIC_API_KEY=
VITE_OPENAI_API_KEY=
VITE_GEMINI_API_KEY=
VITE_GROQ_API_KEY=

# ─── Backend Proxy (Tahap 2 — untuk production) ─────────────────────────────────
# Set ke true dan isi URL untuk menyembunyikan API key dari client
VITE_USE_BACKEND_PROXY=false
VITE_BACKEND_URL=http://localhost:3001

# ─── App ────────────────────────────────────────────────────────────────────────
VITE_APP_NAME=Wedding Studio
